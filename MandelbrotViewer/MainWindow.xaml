<Window
    x:Class="MandelbrotViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MandelbrotViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Mandelbrot Explorer">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Window-wide shortcuts (work regardless of which control has focus) -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarColumn" Width="380" MinWidth="0" MaxWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- Viewport Area -->
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="JuliaColumn" Width="0"/>
            </Grid.ColumnDefinitions>
        <Grid x:Name="ViewportGrid" Grid.Column="0" Background="#0A0A0F" SizeChanged="OnViewportSizeChanged">
            <Canvas x:Name="FractalSurface" Background="Transparent"
                   PointerPressed="OnViewportPointerPressed"
                   PointerMoved="OnViewportPointerMoved"
                   PointerReleased="OnViewportPointerReleased"
                   PointerCanceled="OnViewportPointerReleased"
                   PointerCaptureLost="OnViewportPointerReleased"
                   PointerWheelChanged="OnViewportPointerWheelChanged"
                   DoubleTapped="OnViewportDoubleTapped">
                <Image x:Name="FractalImage" Stretch="Fill" IsHitTestVisible="False" />
                <Ellipse x:Name="JuliaPointMarker" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                         Fill="#7048B5E0" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Canvas>

            <!-- Floating Telemetry HUD -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16" CornerRadius="8" Padding="14,10"
                    Background="#D012121A" BorderBrush="#33FFFFFF" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="HudTitleText" Text="MANDELBROT SET" FontWeight="SemiBold" FontSize="11" Foreground="#99FFFFFF" CharacterSpacing="100"/>
                    <TextBlock x:Name="HudCoordsText" Text="Center: (-0.75000000, +0.00000000)" FontFamily="Consolas" FontSize="12" Foreground="#EEFFFFFF"/>
                    <TextBlock x:Name="HudZoomText" Text="Zoom: 1.0x" FontFamily="Consolas" FontSize="12" Foreground="#80D8FF"/>
                    <TextBlock x:Name="HudTimingText" Text="Fractal: 0.0 ms | Color: 0.0 ms" FontFamily="Consolas" FontSize="11" Foreground="#80E8A0"/>
                </StackPanel>
            </Border>

            <!-- Floating Controls Panel Toggle Button (visible when sidebar is closed) -->
            <Button x:Name="OpenSidebarButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="16" Click="OnOpenSidebarClick" ToolTipService.ToolTip="Show Controls Panel (Esc to toggle)"
                    Background="#D0161622" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Padding="12,8" CornerRadius="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#80D8FF"/>
                    <TextBlock Text="Controls Panel" FontWeight="SemiBold" FontSize="12" Foreground="#EEFFFFFF"/>
                </StackPanel>
            </Button>

            <!-- Floating Overlay Navigation Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="16">
                <Button x:Name="OverlayPlayZoomButton" Click="OnOverlayZoomToggleClick" ToolTipService.ToolTip="Start Animated Zoom"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon x:Name="OverlayPlayZoomIcon" Glyph="&#xE768;" FontSize="14" Foreground="#51CF66" />
                </Button>
                <Button x:Name="ZoomInButton" Click="OnZoomInClick" ToolTipService.ToolTip="Zoom In (+25%)"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button x:Name="ZoomOutButton" Click="OnZoomOutClick" ToolTipService.ToolTip="Zoom Out (-20%)"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon Glyph="&#xE738;" FontSize="14" />
                </Button>
                <Button x:Name="ResetViewButton" Click="OnResetViewClick" ToolTipService.ToolTip="Reset to Default Overview"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                </Button>
                <Button x:Name="ToggleSidebarButton" Click="OnToggleSidebarClick" ToolTipService.ToolTip="Toggle Controls Panel (Full Window View)"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon x:Name="ToggleSidebarIcon" Glyph="&#xE8A0;" FontSize="14" />
                </Button>
                <Button x:Name="ToggleFullScreenButton" Click="OnToggleFullScreenClick" ToolTipService.ToolTip="Enter Full Screen (F11)"
                        Background="#CC1E1E28" Padding="10,6" CornerRadius="6">
                    <FontIcon x:Name="ToggleFullScreenIcon" Glyph="&#xE740;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

            <Border x:Name="JuliaPane" Grid.Column="1" Visibility="Collapsed" BorderBrush="#44FFFFFF" BorderThickness="1,0,0,0">
                <Grid x:Name="JuliaViewportGrid" Background="#0A0A0F" SizeChanged="OnJuliaViewportSizeChanged">
                    <Canvas x:Name="JuliaSurface" Background="Transparent"
                            PointerPressed="OnJuliaPointerPressed" PointerMoved="OnJuliaPointerMoved"
                            PointerReleased="OnJuliaPointerReleased" PointerCanceled="OnJuliaPointerReleased"
                            PointerCaptureLost="OnJuliaPointerReleased" PointerWheelChanged="OnJuliaPointerWheelChanged"
                            DoubleTapped="OnJuliaDoubleTapped">
                        <Image x:Name="JuliaImage" Stretch="Fill" IsHitTestVisible="False"/>
                    </Canvas>
                    <Border VerticalAlignment="Top" Margin="12" Padding="12,8" CornerRadius="8"
                            Background="#D012121A" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="JULIA SET" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Click="OnJuliaCloseClick" AutomationProperties.Name="Close Julia view"
                                        ToolTipService.ToolTip="Hide Julia View" Background="Transparent" BorderThickness="0" Padding="4">
                                    <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="JuliaParameterText" FontFamily="Consolas" FontSize="11" Foreground="#EEFFFFFF"
                                       TextWrapping="Wrap" Text="c = -0.75 + 0i"/>
                            <TextBlock x:Name="JuliaZoomText" FontFamily="Consolas" FontSize="12" Foreground="#80D8FF"/>
                            <TextBlock x:Name="JuliaTimingText" FontFamily="Consolas" FontSize="11" Foreground="#80E8A0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                        <Button Click="OnJuliaZoomInClick" AutomationProperties.Name="Zoom Julia in" ToolTipService.ToolTip="Zoom Julia In"
                                Background="#CC1E1E28" Padding="10,6" CornerRadius="6"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
                        <Button Click="OnJuliaZoomOutClick" AutomationProperties.Name="Zoom Julia out" ToolTipService.ToolTip="Zoom Julia Out"
                                Background="#CC1E1E28" Padding="10,6" CornerRadius="6"><FontIcon Glyph="&#xE738;" FontSize="14"/></Button>
                        <Button Click="OnJuliaResetClick" AutomationProperties.Name="Reset Julia view" ToolTipService.ToolTip="Reset Julia View"
                                Background="#CC1E1E28" Padding="10,6" CornerRadius="6"><FontIcon Glyph="&#xE777;" FontSize="14"/></Button>
                        <Button Click="OnJuliaExportClick" AutomationProperties.Name="Export Julia image" ToolTipService.ToolTip="Export Julia PNG"
                                Background="#CC1E1E28" Padding="10,6" CornerRadius="6"><FontIcon Glyph="&#xE74E;" FontSize="14"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Sidebar Control Panel -->
        <Border x:Name="SidebarBorder" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Padding="20,16,20,24" Spacing="16">

                    <!-- Title Header with Close Button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Fractal Studio" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="WinUI 3 &amp; Native C++ ARM64 Engine" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="CloseSidebarButton" Grid.Column="1" VerticalAlignment="Center"
                                Click="OnCloseSidebarClick" ToolTipService.ToolTip="Hide Controls (Full Window View)"
                                Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Fractal Formula Selector -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Fractal Formula" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox x:Name="FractalTypeComboBox" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnFractalTypeSelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="JuliaOptionsPanel" Spacing="8">
                        <ToggleSwitch x:Name="ShowJuliaToggle" Header="Julia Companion" IsOn="False"
                                      OnContent="Side-by-side view" OffContent="Hidden" Toggled="OnJuliaViewToggled"/>
                        <StackPanel x:Name="JuliaSettingsPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock Text="Click a point in Mandelbrot to choose c. Drag either image to pan; scroll to zoom."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Use Mandelbrot Center" HorizontalAlignment="Stretch" Click="OnJuliaUseCenterClick"/>
                            <Button Content="Copy Julia Coordinates &amp; Config" HorizontalAlignment="Stretch" Click="OnJuliaCopyCoordsClick"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Presets & Bookmarks -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Locations &amp; Bookmarks" FontWeight="SemiBold" FontSize="13"/>
                        <ComboBox x:Name="BookmarksComboBox" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnBookmarkSelectionChanged" PlaceholderText="Select a landmark..."/>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Animated Zoom Controls -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Animated Zoom" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Button x:Name="UseCurrentCenterButton" Grid.Column="1" Click="OnUseCurrentCenterClick"
                                    ToolTipService.ToolTip="Set target coordinates to current viewport center"
                                    Padding="8,4" FontSize="11" Content="Use Current"/>
                        </Grid>

                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Target X" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TargetXTextBox" Grid.Row="0" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                                     Text="-0.75000000" PlaceholderText="Real (X) coordinate"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target Y" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TargetYTextBox" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                                     Text="+0.00000000" PlaceholderText="Imaginary (Y) coordinate"/>
                        </Grid>

                        <ToggleSwitch x:Name="RandomTargetToggle" Header="Auto-Pick Target"
                                      OnContent="Random Interesting Spot (Auto-Retargets)"
                                      OffContent="Manual Target Coordinate"
                                      IsOn="False"
                                      Toggled="OnRandomTargetToggleChanged"/>

                        <!-- Zoom Direction (Zoom In / Zoom Out) -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ZoomDirectionInToggle" Grid.Column="0" HorizontalAlignment="Stretch"
                                          IsChecked="True" Click="OnZoomDirectionInClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                    <TextBlock Text="Zoom In"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="ZoomDirectionOutToggle" Grid.Column="1" HorizontalAlignment="Stretch"
                                          IsChecked="False" Click="OnZoomDirectionOutClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                    <TextBlock Text="Zoom Out"/>
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <!-- Zoom Speed Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zoom Speed" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ZoomSpeedValueText" Grid.Column="1" Text="1.0x" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </Grid>
                        <Slider x:Name="ZoomSpeedSlider" Minimum="0.2" Maximum="5.0" StepFrequency="0.1" Value="1.0"
                                ValueChanged="OnZoomSpeedSliderChanged"/>

                        <!-- Start & Stop Zoom Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartZoomButton" Grid.Column="0" HorizontalAlignment="Stretch"
                                    Click="OnStartZoomClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="#51CF66"/>
                                    <TextBlock Text="Start Zoom" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopZoomButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                    Click="OnStopZoomClick" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="#FF6B6B"/>
                                    <TextBlock Text="Stop Zoom" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Render Quality & Calculation Settings -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Calculation Parameters" FontWeight="SemiBold" FontSize="13"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Max Iterations" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IterationsValueText" Grid.Column="1" Text="500" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </Grid>
                        <Slider x:Name="IterationsSlider" Minimum="50" Maximum="50000" StepFrequency="50" Value="500"
                                ValueChanged="OnIterationsSliderChanged"/>

                        <ToggleSwitch x:Name="AutoIterationsToggle" Header="Auto-Scale Iterations"
                                      OnContent="Dynamic (Scales with Deep Zoom)"
                                      OffContent="Manual Fixed"
                                      IsOn="True"
                                      Toggled="OnAutoIterationsToggleChanged"/>

                        <ToggleSwitch x:Name="SmoothToggle" Header="Coloring Mode"
                                      OnContent="Continuous (Smooth Potential)"
                                      OffContent="Discrete Steps"
                                      IsOn="True"
                                      Toggled="OnSmoothToggleChanged"/>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Color Theme & Live Tuning -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Color Theme &amp; Live Tuning" FontWeight="SemiBold" FontSize="13"/>

                        <ComboBox x:Name="ThemePresetComboBox" Header="Preset Palette" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnThemePresetSelectionChanged"/>

                        <!-- Live Palette Preview Bar -->
                        <Border Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image x:Name="PalettePreviewImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>

                        <!-- Live Cycle Frequency Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Color Frequency" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FrequencyValueText" Grid.Column="1" Text="1.00x" FontFamily="Consolas"/>
                        </Grid>
                        <Slider x:Name="FrequencySlider" Minimum="0.0005" Maximum="2.0" StepFrequency="0.0005" SmallChange="0.0005" LargeChange="0.01" Value="1.0"
                                ValueChanged="OnFrequencySliderChanged"/>

                        <!-- Live Phase / Cycle Offset Slider -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cycle Offset (Phase)" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PhaseValueText" Grid.Column="1" Text="0.00" FontFamily="Consolas"/>
                        </Grid>
                        <Slider x:Name="PhaseSlider" Minimum="0.0" Maximum="1.0" StepFrequency="0.005" Value="0.0"
                                ValueChanged="OnPhaseSliderChanged"/>

                        <!-- Palette Animation & Invert -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="AnimateToggle" Grid.Column="0" HorizontalAlignment="Stretch"
                                          Click="OnAnimateToggleClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock Text="Cycle Colors"/>
                                </StackPanel>
                            </ToggleButton>

                            <CheckBox x:Name="InvertCheckBox" Grid.Column="1" Content="Invert Palette"
                                      Checked="OnInvertChecked" Unchecked="OnInvertUnchecked"/>
                        </Grid>
                    </StackPanel>

                    <MenuFlyoutSeparator />

                    <!-- Custom Gradient Stop Editor -->
                    <Expander Header="Custom Gradient Stops" HorizontalAlignment="Stretch" IsExpanded="False">
                        <StackPanel Spacing="10" Padding="0,8,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="StopSelectorComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                          Header="Select Stop" SelectionChanged="OnStopSelectionChanged"/>
                                <Button x:Name="AddStopButton" Grid.Column="1" VerticalAlignment="Bottom"
                                        Click="OnAddStopClick" ToolTipService.ToolTip="Add Stop">
                                    <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                </Button>
                                <Button x:Name="RemoveStopButton" Grid.Column="2" VerticalAlignment="Bottom"
                                        Click="OnRemoveStopClick" ToolTipService.ToolTip="Remove Selected Stop">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                            </Grid>

                            <!-- Stop Position Slider -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stop Position" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StopPositionText" Grid.Column="1" Text="0.00" FontFamily="Consolas"/>
                            </Grid>
                            <Slider x:Name="StopPositionSlider" Minimum="0.0" Maximum="1.0" StepFrequency="0.01" Value="0.0"
                                    ValueChanged="OnStopPositionSliderChanged"/>

                            <!-- Stop Color RGB & Swatch -->
                            <TextBlock Text="Stop Color" FontWeight="SemiBold" FontSize="12"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center">
                                    <Rectangle x:Name="StopColorSwatch" Fill="#000764"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <!-- Red Slider -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF6B6B" FontWeight="Bold"/>
                                        <Slider x:Name="StopRedSlider" Grid.Column="1" Minimum="0" Maximum="255" StepFrequency="1"
                                                ValueChanged="OnStopColorChanged" Margin="6,0"/>
                                        <TextBlock x:Name="StopRedText" Grid.Column="2" Text="0" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Green Slider -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="G" VerticalAlignment="Center" Foreground="#51CF66" FontWeight="Bold"/>
                                        <Slider x:Name="StopGreenSlider" Grid.Column="1" Minimum="0" Maximum="255" StepFrequency="1"
                                                ValueChanged="OnStopColorChanged" Margin="6,0"/>
                                        <TextBlock x:Name="StopGreenText" Grid.Column="2" Text="7" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Blue Slider -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="B" VerticalAlignment="Center" Foreground="#339AF0" FontWeight="Bold"/>
                                        <Slider x:Name="StopBlueSlider" Grid.Column="1" Minimum="0" Maximum="255" StepFrequency="1"
                                                ValueChanged="OnStopColorChanged" Margin="6,0"/>
                                        <TextBlock x:Name="StopBlueText" Grid.Column="2" Text="100" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <MenuFlyoutSeparator />

                    <!-- Actions & Export -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Export &amp; Share" FontWeight="SemiBold" FontSize="13"/>
                        <Button x:Name="ExportImageButton" HorizontalAlignment="Stretch" Click="OnExportImageClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                                <TextBlock Text="Export Viewport Image (PNG)..."/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyCoordsButton" HorizontalAlignment="Stretch" Click="OnCopyCoordsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                <TextBlock Text="Copy Coordinates &amp; Config"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
